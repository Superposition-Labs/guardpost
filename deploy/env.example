# /opt/guardpost/.env (chmod 600, owned by root). docker compose reads it for the ${...} in
# compose.yml; each service receives only the variables compose.yml lists for it.
# One instance per data jurisdiction: this file differs per region, the compose files do not.

# --- compose -------------------------------------------------------------------------------
# "litestream" runs the replication sidecar (needs the LITESTREAM_* below).
COMPOSE_PROFILES=litestream
# Add the loopback-only dashboard port: COMPOSE_FILE=compose.yml:compose.dashboard.yml
#COMPOSE_FILE=compose.yml
# The app stack's external docker network; Guardpost joins it with the alias "guardpost".
GUARDPOST_NETWORK=factory_network
# Pin a release minor. RU: the mirrored copy, e.g. <registry>/guardpost:0.4
GUARDPOST_IMAGE=ghcr.io/superposition-labs/guardpost:0.4
#LITESTREAM_IMAGE=litestream/litestream:0.5.17
#GUARDPOST_VOLUME=guardpost_data
#GUARDPOST_LOCAL_PORT=8200

# --- guardpost -----------------------------------------------------------------------------
# Instance secret for every per-tenant HMAC (bans, the v2 ledger). Generate once per region:
#   openssl rand -hex 32
# Store it in the region's secret store AND offline, never in the backup bucket. Losing it makes
# every keyed hash in the database useless (re-backfill); a different one refuses to boot.
GUARDPOST_SECRET=
# The tenant that GUARDPOST_API_KEY and pre-0.3 data belong to. Must be set before the first
# `guardpost migrate` of a 0.2 database: the first value recorded wins.
GUARDPOST_LEGACY_TENANT=factory
# The 0.2 single key, still used by Factory v1 (Larp-Factory's GUARDPOST_API_KEY, same value).
# Unset it once v1 no longer calls Guardpost: the legacy key is then revoked on boot.
GUARDPOST_API_KEY=
# Requests/min per tenant (a tenant's rate_limit_per_minute overrides it); 0 = off.
GUARDPOST_RATE_LIMIT=0
# Apps call over the docker network, so no proxy sets X-Forwarded-For: leave empty.
GUARDPOST_TRUSTED_PROXIES=
# Instance default for trusted app-internal domains (a tenant's email.trusted_extra_domains overrides).
GUARDPOST_TRUSTED_EXTRA_DOMAINS=factory.bot,deleted.local
# v1 pattern report (in-memory window); the v2 check does not use it.
GUARDPOST_ENABLE_PATTERNS=1
GUARDPOST_PURGE_INTERVAL=3600
# Shared IP reputation reasons show the status only (graylisted_ip:graylisted); a tenant's
# ip.reason_detail=full is honoured only while it is alone on the instance. 1 = honour it anyway
# (the reasons then reveal counts that other tenants' signups produced). Leave empty.
GUARDPOST_ALLOW_FULL_REASON_DETAIL=

# --- litestream ----------------------------------------------------------------------------
# Global (Cloudflare R2):  LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                          LITESTREAM_REGION=auto
# RU (Yandex Object Storage, ru-central1; RU data never leaves Russia):
#                          LITESTREAM_ENDPOINT=https://storage.yandexcloud.net
#                          LITESTREAM_REGION=ru-central1
#                          LITESTREAM_SIGN_PAYLOAD=true
#                          LITESTREAM_REQUIRE_CONTENT_MD5=true
LITESTREAM_BUCKET=
LITESTREAM_PATH=guardpost
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
# A key scoped to this bucket (and prefix, where the store supports it).
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_SIGN_PAYLOAD=
LITESTREAM_REQUIRE_CONTENT_MD5=
# Optional dead-man's switch, pinged every 5 minutes while replication is healthy.
LITESTREAM_HEARTBEAT_URL=

# --- nightly snapshot (scripts/backup-snapshot.sh, from cron) ------------------------------
SNAPSHOT_DIR=/opt/guardpost/snapshots
SNAPSHOT_KEEP_DAYS=14
# age public key: snapshots are encrypted before they leave the host (recommended).
SNAPSHOT_AGE_RECIPIENT=
# rclone destination for an off-host copy, e.g. r2:<bucket>/guardpost/snapshots (RU: a
# Russian store). Empty: local copies only.
SNAPSHOT_RCLONE_DEST=
